{
  "name": "atoms-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node .next/standalone/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify:templates": "tsx --conditions=react-server scripts/verify-templates.ts",
    "test:e2e": "playwright test --trace off",
    "db:generate": "drizzle-kit generate",
    "usage": "tsx scripts/usage-report.ts",
    "smoke:llm": "tsx --conditions=react-server scripts/smoke-llm.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^1.0.65",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-json": "^6.0.2",
    "@uiw/react-codemirror": "^4.25.13",
    "ai": "^5.0.294",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.81.0",
    "nanoid": "^5.1.16",
    "next": "^15.5.29",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^3.0.6",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.7",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.29",
    "playwright": "^1.63.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
