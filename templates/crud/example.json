{
  "title": "我的书架",
  "subtitle": "记录读过、在读和想读的每一本书",
  "emoji": "📖",
  "locale": "zh-CN",
  "theme": { "primary": "orange", "mode": "light" },
  "entity": { "singular": "书", "plural": "书单" },
  "fields": [
    { "key": "title", "label": "书名", "type": "text", "required": true, "placeholder": "例如：三体" },
    { "key": "author", "label": "作者", "type": "text", "placeholder": "作者姓名" },
    { "key": "genre", "label": "分类", "type": "select", "options": ["小说", "历史", "科普", "商业", "心理", "传记"] },
    { "key": "status", "label": "阅读状态", "type": "select", "required": true, "options": ["想读", "在读", "读完"] },
    { "key": "rating", "label": "评分", "type": "rating" },
    { "key": "pages", "label": "页数", "type": "number", "min": 1, "max": 5000 },
    { "key": "finishedOn", "label": "读完日期", "type": "date" },
    { "key": "notes", "label": "读书笔记", "type": "textarea", "placeholder": "一句话感想" }
  ],
  "titleField": "title",
  "subtitleField": "author",
  "searchFields": ["title", "author", "notes"],
  "filterField": "status",
  "sortOptions": [
    { "key": "createdAt", "label": "最近添加", "dir": "desc" },
    { "key": "rating", "label": "评分从高到低", "dir": "desc" },
    { "key": "finishedOn", "label": "读完日期", "dir": "desc" },
    { "key": "title", "label": "书名", "dir": "asc" }
  ],
  "defaultView": "cards",
